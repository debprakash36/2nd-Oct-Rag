# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Node / Next.js. `web/node_modules` is ~418 MB across ~22k files and is restored by
# `npm ci`, so it must never be committed.
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.pytest_cache/

# Load-test benchmark cache. The seeded corpus is derived from samples/ and takes
# ~45 s to build, so it is cached rather than rebuilt per run. `make clean-cache`.
.load_cache/
load*.txt
tmp_loadprobe/

# Local state. Generated by scripts/ingest_corpus.py and by the app; contains
# extracted corpus text and object-store bytes, none of which belong in git.
data/
samples/
*.db
*.sqlite
*.sqlite3
# Backups of the above. `rag.db.pre_purge_backup` ends in `_backup`, so neither
# `*.db` nor `*.backup` matches it; `*_backup` is what actually catches these.
*_backup
*.backup
*.db-*
.env

# Corpus verification output
corpus_*.db

# Unrelated to this project. These are coursework and personal files that happen to
# live in the same folder; they are not part of the RAG chatbot and must not be
# published to the remote. Listed explicitly rather than deleted, so they stay on
# disk and stay recoverable.
Sem 1/
Sem 2/
Documents/
office/
*.xlsx
*.wfp
*.jpg
*.jpeg
*.png
html.html
new.html
pytest.out

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini