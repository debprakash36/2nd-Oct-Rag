# Local environment. Copy to `.env` and adjust. `.env` itself is gitignored so
# real credentials and hostnames are never committed.
#
# Every value here is also the documented default in app/core/config.py, except
# where noted. Settings are read from the environment, so exporting a variable
# works identically to putting it here.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Persistence ---------------------------------------------------------
# SQLite for local runs and tests. Production and staging reject SQLite: the
# vector column uses pgvector, which SQLite does not provide.
DATABASE_URL=sqlite:///./rag.db

# Postgres example:
#   postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Embeddings ----------------------------------------------------------
# Pinned. Changing EMBEDDING_DIM invalidates every stored vector, so it must be
# treated as a schema change, not a config tweak -- a full re-ingest, not a restart.
#
#   fake        = local hash-based embedder. Deterministic, free, no key. Default.
#   huggingface = HuggingFace Inference API. A network round-trip per embed, and
#                 billed per request, so it is opt-in rather than the default.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embed-v1
EMBEDDING_DIM=384

# --- HuggingFace Inference API (embeddings) ------------------------------
# Only read when EMBEDDING_PROVIDER=huggingface. No `huggingface_hub` dependency:
# the feature-extraction pipeline is one HTTP POST and `httpx` is the whole client.
HF_TOKEN=
HF_INFERENCE_URL=https://api-inference.huggingface.co
# 384-dimensional, so it matches EMBEDDING_DIM above. Changing model or dimension
# requires re-ingesting the corpus.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TIMEOUT_SECONDS=30
HF_EMBED_BATCH_SIZE=16

# --- Vector store backend (FR-12) ------------------------------------------
# There is no "auto". The backend is named, and the name must match the database:
#   sqlite    = brute-force scan in Python over the JSON embedding column (default;
#               pairs with the default SQLite DATABASE_URL)
#   pgvector  = ANN index in Postgres; a Postgres deployment must set this
#   chroma    = a derived ANN projection, selectable on either database
#
# A mismatch fails at startup rather than being inferred, because inference is what
# let a populated index on disk sit beside a different serving store with neither
# reporting the disagreement.
#
# 'chroma' requires the optional dependency: `pip install -e ".[chroma]"`.
# The Chroma collection is NOT written by ingestion -- run
# `python scripts/sync_chroma_index.py` after ingesting, or retrieval returns
# nothing from the vector stage. SQL stays authoritative for text, ACL tags, and
# tombstones either way. Because it is a copy, it is stale until re-projected:
# /health reports it as "N/M live chunks" and startup logs a warning when it lags.
VECTOR_STORE=sqlite
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=chunks

# --- Ingestion queue ------------------------------------------------------
# Off means the pipeline runs inline and a document is `live` by the time the
# upload response returns. Enable with a broker URL to ingest asynchronously.
INGEST_QUEUE_ENABLED=false
# INGEST_QUEUE_BROKER_URL=redis://localhost:6379/0
#
# When a broker is enabled, required=true refuses uploads when the broker is
# down rather than leaving `pending` documents that never become queryable.
INGEST_QUEUE_REQUIRED=true
INGEST_MAX_ATTEMPTS=3
# Must exceed SANDBOX_TIMEOUT_SECONDS, or a slow extraction looks like a dead
# worker and gets redelivered while it is still running.
INGEST_VISIBILITY_TIMEOUT_SECONDS=300

# --- Limits --------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Chat (FR-23, FR-30, FR-31, FR-34) -----------------------------------
# Rejected before rate limiting and before any provider call, with a user-safe
# message.
CHAT_MAX_QUERY_CHARS=4000
# Prior turns fed to the model. 0 disables history in the prompt only -- turns
# are still persisted, so a conversation remains readable after the fact.
CHAT_HISTORY_TURNS=6
# Prior user questions passed to retrieval for follow-up resolution. Independent
# of CHAT_HISTORY_TURNS. 0 sends the current question alone.
RETRIEVAL_MEMORY_TURNS=10
# Fixed window per client identity, held in process. 0 disables the limit.
# Behind a proxy, configure it to trust exactly one hop, or every client will
# share the proxy's address and one client can exhaust everyone's quota.
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Web UI origin -------------------------------------------------------
# The browser UI is a separate origin, so the API must allow it explicitly.
# Comma-separated. Defaults to the local dev port only; a deployment that omits
# this will refuse browser requests rather than serve any origin.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Access --------------------------------------------------------------
# Empty leaves every endpoint open (local tests). Staging and production
# refuse to start without a value. The browser asks for it on the sign-in
# screen and sends it as Authorization: Bearer. It is not a NEXT_PUBLIC variable.
API_TOKEN=

# --- Sandbox (NFR-5) -----------------------------------------------------
# Timeout and output cap are enforced on every platform. Memory and network
# isolation require POSIX resource limits and a container; on Windows they are
# not enforced, and the worker must run in a container in staging/production.
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_BYTES=536870912
SANDBOX_MAX_OUTPUT_CHARS=20000000

# --- Object store --------------------------------------------------------
OBJECT_STORE_DIR=./data/objects

# --- Generation ----------------------------------------------------------
# Swappable behind `GenerationProvider` (NFR-10).
#
#   fake = offline extractive reader. NOT a language model: it selects sentences
#          from the retrieved passages. It proves the citation pipeline and the
#          TTFT budget work, and its output must not be read as evidence about
#          model quality. Default.
#   groq = Groq's OpenAI-compatible /chat/completions, streamed over SSE.
GENERATION_PROVIDER=fake
GENERATION_MODEL=fake-gen-v1
GENERATION_MAX_TOKENS=1024
# 0.0 suits extraction; real generation usually reads better around 0.2-0.7.
GENERATION_TEMPERATURE=0.0

# --- Groq (generation) ---------------------------------------------------
# Only read when GENERATION_PROVIDER=groq. Raises at startup if the provider is
# selected with an empty key, rather than failing later as a 503 on a user query.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
# Deliberately 0. The chat path streams tokens as they arrive, so a mid-stream
# retry would duplicate text the user has already read or stall a partial answer.
GROQ_MAX_RETRIES=0

# --- Reranking -----------------------------------------------------------
# `lexical` is the offline stand-in and scores above the relevance threshold, so
# it does not force abstention. `null` scores zero everywhere and abstains under
# any positive threshold -- the safe direction in which to fail.
RERANKER_PROVIDER=lexical